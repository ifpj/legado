# Empty: automatically use the browser/request host, port and proxy HTTPS scheme.
# Optional fixed override, e.g. https://books.example.com or http://your-server.lan:122.
FANQIE_RELAY_PUBLIC_URL=
FANQIE_RELAY_PORT=19670
# Empty means no access token. Never commit a configured .env file.
FANQIE_RELAY_TOKEN=
FANQIE_RELAY_CONCURRENCY=8
